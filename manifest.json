{
  "manifest_version": 3,
  "name": "NAVER Minimal",
  "version": "1.1.3",
  "description": "네이버 메인 페이지를 미니멀 검색 화면으로 바꿉니다.",
  "icons": {
  "16": "icons/icon-16x16.png",
  "32": "icons/icon-32x32.png",
  "48": "icons/icon-48x48.png",
  "128": "icons/icon-128x128.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.naver.com/*",
    "https://naver.com/*",
    "https://api.open-meteo.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "naver_home_redirect",
        "enabled": true,
        "path": "rules/redirect_rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "minimal.html",
        "style.css",
        "script.js"
      ],
      "matches": [
        "https://www.naver.com/*",
        "https://naver.com/*"
      ]
    }
  ]
}
